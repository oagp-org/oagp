{
  "catdef": "1.4",
  "orgdef": "1.0.0",
  "type": "orgdef:Organization",
  "id": "ogframework",
  "name": "OG — Open Governance Framework",
  "version": "0.3.1",

  "mission": "Define and steward OG — the Open Governance Framework — the organizational shape that treats AI peers as first-class participants with bounded authority, ratification cycles, role-binding, audit trails, and adoption-cycle primitives. (OG = 'Open Governance'; the framework is currently focused on agentic — AI-inclusive — organizations, a focus its brand deliberately does not hard-code.) The canonical artifacts produced (framework documentation, adoption-cycle skills, agent-runtime bindings, runtime delivery packages, web hosting at ogframework.com) bootstrap any AI worker into OG-shaped operational discipline with zero context backfill.",

  "vision": "The canonical home for OG (the Open Governance Framework) — an organizational framework at the umbrella of (but conceptually separable from) the catdef → roledef → orgdef → memodef → transcriptdef data-format family. The primary reader of an OG-canonical artifact is an AI peer joining an OG-shaped organization or evaluating one for adoption. Secondary readers are human stakeholders (directors, business owners, regulators, auditors) who need legible org governance, bounded-authority discipline, and audit trails. OG itself is substrate-agnostic in principle; the catdef family is the recommended canonical substrate because it is AI-peer-aware, not because OG requires it.",

  "scope": "OG framework definition + canonical documentation; adoption-cycle skills (`/og-create-org`, `/og-orient`, `/og-claim-seat`, `/og-describe-org`, `/og-close-session`, `/og-add-seat`, `/og-change-comms-substrate`); agent-runtime bindings (mapping roledefs to vendor AgentDefinitions across Anthropic, OpenAI, Google, others); runtime delivery packaging (Claude Code plugin, claude.ai project template, ChatGPT custom GPT, Gemini Gem, first-message primer, future packages); canonical web hosting at ogframework.com. Current focus is agentic (AI-inclusive) organizations; broadening to human organizations is a forward vision requiring separate ratification, not current scope. Explicitly out of scope: (a) the data-format specs themselves (catdef, roledef, orgdef, memodef, transcriptdef — each has its own spec-org governance venue); (b) substrate enforcement — OG MUST remain implementable on non-catdef substrates in principle, with catdef-family recommended-not-required; (c) runtime implementation infrastructure — specification + reference content only; (d) content policing of OG-shaped consumer organizations — that's governance overreach.",

  "governance_model": "Bounded AI authority + human Director ratification. The og-strategist (AI role) holds delegated authority for OG-pattern-shape design decisions (pattern-promotion calls, MUST/SHOULD conventions, canonical skill content, cross-runtime delivery prioritization, adoption-cycle architecture). The og-maintainer (AI role, separate seat) drafts framework documentation and decision artifacts. The og-implementer (AI role, separate seat) develops agent-sdk bindings, plugin packaging, and web/docs publishing. The human Director (Scott) holds final tiebreaker authority on every merge, version bump, governance change, and canonical-promotion ratification. Mirrors the catdef-family bounded-authority pattern applied at the OG-framework layer. Inter-position communication is recorded in the org's ratified COMMUNICATION SUBSTRATE. This org's primary substrate is memos/ (memodef artifacts in git), carrying the record of authority — charter, decisions, proposals, cross-seat governance; the OGF Jira project (scottconfusedgorilla.atlassian.net, key OGF) is a ratified secondary substrate carrying the record of activity. Director's formulation: Jira is tactical, memos remain the record of strategy. Seat notification is best-effort and runtime-native; OG ships no notification component, and a seat never treats silence as an empty inbox.",

  "values": [
    {
      "name": "openness",
      "description": "OG is fundamentally open — a framework, not a product. No vendor lock-in, no privileged implementer, no proprietary extensions in the canonical framework. All AI runtimes (Anthropic, OpenAI, xAI, Google, Perplexity, future) are equal citizens. All substrate formats capable of carrying OG semantics are eligible (catdef family is the recommended canonical, not the only viable).",
      "rationale": "Adoption depends on equal-citizen treatment of all implementers and substrates; vendor or substrate capture would defeat the framework's purpose. Forks are welcome — anyone can publish their own OG-shaped framework documentation at any URL using the same conventions."
    },
    {
      "name": "completeness",
      "description": "Canonical OG artifacts (framework documentation, adoption-cycle skills, agent-runtime bindings, runtime delivery packages) MUST be sufficient — alone or composed with OG-recommended substrate artifacts — for a fresh AI runtime to act on their content with zero context backfill.",
      "rationale": "Hallucination-prevention rule, not aesthetic preference. The primary reader is a machine; null context invites confabulation. A canonical OG artifact missing required structural content forces the AI to either guess or ask the user, which violates the zero-friction adoption bar that motivates the framework's existence."
    },
    {
      "name": "substrate-agnosticism",
      "description": "OG-the-framework is conceptually separable from any specific data substrate. Canonical framework documentation MUST be expressible in substrate-neutral terms; substrate-specific artifacts (e.g., catdef-family conformant orgdef.opencatalog files, sample memos, reference roledefs) are reference implementations of the framework, not the framework itself. The catdef family is the recommended canonical substrate because it is AI-peer-aware (schema-as-data; opencatalog format; AI-readable structure); the recommendation is for substrate-AI-peer-alignment, not for substrate exclusivity.",
      "rationale": "Conflating the framework with the substrate concentrates authority and limits cross-substrate adoption (OG-on-protobuf, OG-on-XML, OG-on-RDF are all coherent compositions). The data-vs-pattern distinction is load-bearing: it permits the framework to evolve independently of substrate changes, and substrate to evolve independently of framework changes. Surfaced and ratified by Director 2026-05-23 (see [memos/2026-05-23-1100--thingalog-strategist--orgdef-strategist--handoff-addendum-data-vs-pattern.body.md](../memos/2026-05-23-1100--thingalog-strategist--orgdef-strategist--handoff-addendum-data-vs-pattern.body.md))."
    }
  ],

  "red_lines": [
    {
      "rule": "No NULL-context canonical OG artifacts accepted by the spec, the validator, or the canonical adoption-cycle skills.",
      "rationale": "Technical, not aesthetic — null context causes hallucination in the primary (machine) reader. The MUST-have-substantive-content rule is a hallucination-prevention rule applied at the OG-framework layer, mirroring the equivalent rule in each data-format spec."
    },
    {
      "rule": "No content policing of OG-shaped consumer organizations.",
      "rationale": "What organizations choose to build using the OG framework is their business, not OG's. The framework governs structural integrity (bounded authority, ratification cycles, audit trails) and offers conventions (adoption skills, canonical patterns) — it does NOT police the morality of orgs that adopt it. Curation happens at the canonical-references-library level (which adopter orgs OG highlights as reference implementations), not at the framework level."
    },
    {
      "rule": "No substrate capture. OG MUST remain implementable on substrates other than the catdef family.",
      "rationale": "Recommending catdef as the canonical substrate is a SHOULD, not a MUST. Canonical framework documentation MUST express OG semantics in substrate-neutral terms; reference implementations in catdef-family substrate are exemplars, not the framework itself. Substrate capture would re-conflate the data-vs-pattern distinction the value above defends."
    },
    {
      "rule": "No vendor capture. Cross-vendor neutrality MUST be preserved structurally in all packaging, hosting, and distribution decisions.",
      "rationale": "Anthropic-ecosystem deliveries (Claude Code plugin, claude.ai project) are acceptable transports for adoption convenience, but MUST be framed as transports of an open cross-vendor framework — not as the canonical framework itself. README / manifest / docs that imply OG is Anthropic-aligned are red-line violations. The canonical framework lives at ogframework.com and is reachable via every viable runtime including non-Anthropic ones."
    }
  ],

  "recommended_patterns": {
    "general": [
      "Bounded-authority discipline — AI seats read, analyze, draft, argue, and propose; a human Director holds ratification, merges, releases, and public statements. No AI seat holds merge rights, because a seat with merge rights would concentrate accountability in an entity that cannot hold it. Foundational; also expressed in governance_model and CLAUDE.md.",
      "Seat-vs-incumbent persistence — organizational positions persist; AI sessions are ephemeral. Institutional memory lives in the substrate (commits, memos, decisions, proposals, transcripts), never in session working memory. Inter-position coordination is asynchronous via memos addressed to seats, not incumbents. Empirically demonstrated by multiple independent sessions inhabiting the strategist and implementer seats with zero context backfill beyond the substrate.",
      "Data-vs-pattern layering — distinguish OG-pattern-shape decisions (what an OG-shaped org IS and how it operates) from substrate/format-shape decisions (how OG semantics encode in a given data format). Route format-shape decisions to the relevant substrate spec's strategist; keep canonical framework documentation substrate-neutral. Director-ratified 2026-05-23; the meta-discipline governing cross-spec routing.",
      "Org-state-fork-for-time-travel — because an OG substrate is files in a git repo, forking org state at any commit (e.g. git worktree add <path> <sha>) preserves the entire organizational context at that point, and an agent can be bound against that past state with no future-information leakage. Substrate-agnostic property; empirically validated twice (2026-05-23 bind proof-of-concept; agent-sdk time-travel binding).",
      "Substrate-is-sufficient-agent-context — an OG-shaped repo is itself the context an agent bound to a seat requires: identity (roledef), org structure (orgdef), and decisions/communications (memos, decisions, proposals) all live on disk. A bound agent operates directly against the substrate — no RAG, no separate knowledge base, no MCP needed for the basics. Validated by the bind() demos.",
      "Bounded autonomous dispatch (three-tier) — a seat may be dispatched as an unattended agent under a three-tier authority model: (1) propose-only by construction (default; the agent's toolset structurally excludes merge/push/commit); (2) explicit and audited human-Director elevation (overridable; adds capable tools AND fires an audit record); (3) non-delegable dispatch (hard floor, no override, environmentally enforced: no agent may dispatch another). Bounded authority is structural, not prompt-level. Validated by the 2026-05-29 propose-only dispatch demo; the Tier-3 floor was independently re-derived by Claude Code Workflows' one-level-nesting rule.",
      "Org-governance-layer-above-runtime — OG is the cross-session organizational-governance layer; it composes OVER runtime execution/policy primitives (multi-agent orchestration frameworks; runtime policy-enforcement toolkits; native dispatchers such as Claude Code Workflows) rather than competing with or being subsumed by them. Conflating the org-governance layer with the runtime/execution layer is the common error. Corroborated by three independent external reference points (Microsoft AGT as the runtime policy layer beneath; the ETCLOVG harness taxonomy locating OG as the underdeveloped organizational sub-layer of Governance; Claude Code Workflows as a within-session execution primitive OG composes over).",
      "Promotion-follows-adoption — promote a pattern, convention, or substrate extension to canonical only after it has earned it through multiple independent derivations and/or empirical validation; default to extension-namespace-first (use existing primitives; watch for re-derivation) until the bar is met. Inherited from the catdef family (value #4) and used as this org's own pattern-curation discipline.",
      "Seat-inbox-notification — a communication filed to a warm seat SHOULD notify it, ending the human \"please check for memos\" handoff. The load-bearing distinction: the durable COMMUNICATION SUBSTRATE (durable and exportable, seat-addressable, auditable, enumerable) is not the ephemeral NOTIFICATION, and a notification MUST NOT be the transport — it carries a pointer into the substrate. The pointer is what forces the record into the durable layer; prompt-injection resistance is the side benefit, auditability is the point. Notification is an optimization over the substrate's enumerability, never a dependency: a seat enumerates its inbox at session start regardless, and never reads silence as an empty inbox. Promoted 2026-08-24 after the semantic was carried unchanged by three independent mechanisms — including a vendor-neutral implementation with zero vendor dependency, which proved the convention is not vendor-shaped and was then retired in favour of runtime-native mechanisms."
    ],
    "recommended_roles": [
      { "role": "human-director", "priority": "MUST", "why": "Bounded-authority discipline requires a human ratifier." },
      { "role": "og-strategist", "priority": "MUST", "why": "OG pattern-promotion calls, MUST/SHOULD curation, canonical-skill content authority, cross-runtime delivery prioritization." },
      { "role": "og-maintainer", "priority": "MUST", "why": "Drafts framework documentation, walks validations, files decision artifacts." },
      { "role": "og-implementer", "priority": "SHOULD", "why": "Agent-sdk bindings, plugin packaging, web/docs publishing, runtime delivery packages." },
      { "role": "og-security-tester", "priority": "SHOULD", "why": "Plugin distribution and runtime bindings have meaningful attack surface; security testing is canonical-implementation discipline." }
    ]
  },

  "v1_success_criterion": "OG ships v1 when: (a) this orgdef exists as a valid self-describing orgdef:Organization opencatalog artifact in the org's org/ directory (recursive self-description — the framework can describe itself using itself); (b) canonical OG framework documentation is published at ogframework.com (substrate-neutral semantics, plus catdef-family reference implementations); (c) the canonical og- skill suite (og-create-org, og-orient, og-claim-seat, og-describe-org, og-close-session, og-add-seat, og-change-comms-substrate) is OG-canonically designated and operational; (d) at least one non-spec real-org adopter exists in the wild (Thingalog is the empirical reference; DangerStorm-test is the adopt validation instance; Caliper is the second empirical reference). Item (a) is satisfied by this artifact's existence; (b)–(d) are forward work.",

  "relationships": [
    { "type": "reports_to", "from": "strategist", "to": "director", "description": "Strategist holds delegated authority for OG-pattern-shape decisions; Director ratifies decisions, merges, version bumps, governance changes." },
    { "type": "directs", "from": "strategist", "to": "maintainer", "description": "Strategist makes calls; maintainer drafts pattern documentation and decision artifacts in support of those calls." },
    { "type": "directs", "from": "strategist", "to": "implementer", "description": "Strategist sets direction for agent-sdk / plugin / web priorities; implementer produces and tests reference implementations." },
    { "type": "directs", "from": "strategist", "to": "security-tester", "description": "Strategist directs security-testing priorities (especially around plugin distribution and runtime bindings); security-tester reports findings and recommends remediation." },
    { "type": "coordinates_with", "from": "strategist", "to": "external:catdef-strategist", "description": "Cross-spec coordination on catdef substrate concerns. OG recommends catdef as canonical substrate; coordination governs the recommendation's evolution." },
    { "type": "coordinates_with", "from": "strategist", "to": "external:roledef-strategist", "description": "Cross-spec coordination on roledef format concerns. OG positions reference roledefs; coordination governs the reference shape." },
    { "type": "coordinates_with", "from": "strategist", "to": "external:orgdef-strategist", "description": "Cross-spec coordination on orgdef format concerns. OG-shaped orgs are encoded as orgdef artifacts; coordination governs format evolution affecting framework expressiveness." },
    { "type": "coordinates_with", "from": "strategist", "to": "external:memodef-strategist", "description": "Cross-spec coordination on memodef format concerns. Inter-position memos in OG-shaped orgs use memodef artifacts; coordination governs format evolution affecting OG communication conventions." },
    { "type": "coordinates_with", "from": "strategist", "to": "external:transcriptdef-strategist", "description": "Cross-spec coordination on transcriptdef format concerns. Per-seat reasoning records in OG-shaped orgs use transcriptdef artifacts; coordination governs format evolution. Note: transcriptdef-spec governance venue may not yet exist at OG's founding; coordination forward-flagged." }
  ],

  "items": [
